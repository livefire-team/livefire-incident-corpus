/contracts/mcp-tools.schema.json    @<org>/livefire-ws3
/evidence-corpus/                   @<org>/livefire-ws3
/infra/modules/mcp*.bicep           @<org>/livefire-ws3
/.github/workflows/mcp-server.yml   @<org>/livefire-ws3
